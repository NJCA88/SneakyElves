# Local development settings. Copy this file to .env (same folder) and fill it in.
# .env is git-ignored, so the password never goes into the repo.

# Same Neon database as production, but the separate "dev" schema.
# Get the connection string from Neon: project "sneakyelves" -> Connect,
# with "Connection pooling" turned OFF. Then:
#   - delete "&channel_binding=require" from the end if it's there
#   - add "&schema=dev" to the end
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.us-east-2.aws.neon.tech/neondb?sslmode=require&schema=dev"

# Public Google sign-in client ID (same as production)
GOOGLE_CLIENT_ID="496031209257-7kjroq2tihte2mc8a29slolbi75ukcn7.apps.googleusercontent.com"

PORT=3000
